# Breez SDK API Key (PEM-encoded X.509 certificate)
# Required for Android/Web builds that need the built-in Breez Lightning wallet.
# Request your own key from Breez and keep the real value in .env.local or CI secrets.
# Never commit a real key or paste it into tickets/logs.
VITE_BREEZ_API_KEY=your_breez_api_key_here
